ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# A renseigner uniquement si l'API renvoie l'erreur
# "anthropic-workspace-id is required when authenticating with an identity-linked API key"
# Trouvable dans la Console Anthropic > Settings > Workspaces (format wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# Projet Supabase (Project Settings > API) — utilisé uniquement cote serveur
# pour tracer les generations (table "generations"), jamais expose au client.
# Attention : SUPABASE_SERVICE_ROLE_KEY est la cle secrete a privileges eleves
# ("service_role" sur l'ancien systeme de cles JWT, "Secret key" / sb_secret_...
# sur le nouveau) — jamais la cle "anon public" / "Publishable key".
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
