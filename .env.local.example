ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# A renseigner uniquement si l'API renvoie l'erreur
# "anthropic-workspace-id is required when authenticating with an identity-linked API key"
# Trouvable dans la Console Anthropic > Settings > Workspaces (format wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# Projet Supabase (Project Settings > API) — utilisé uniquement cote serveur
# pour tracer les generations (table "generations"), jamais expose au client.
# Attention : SUPABASE_SERVICE_ROLE_KEY est la cle secrete a privileges eleves
# ("service_role" sur l'ancien systeme de cles JWT, "Secret key" / sb_secret_...
# sur le nouveau) — jamais la cle "anon public" / "Publishable key".
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Paiement a l'unite par generation ("pack par entretien"), etape 3.
# Cle secrete Stripe (Developers > API keys) — sk_test_... en dev, sk_live_...
# en production. Jamais exposee au client.
STRIPE_SECRET_KEY=

# Id du prix Stripe (paiement unique, 3,99€) a creer une fois dans le
# Dashboard Stripe (Product catalog). Differe entre mode test et mode live.
STRIPE_PRICE_ID=price_xxx

# Secret de signature du webhook Stripe, pour verifier que les appels a
# /api/webhooks/stripe viennent bien de Stripe. En local, fourni par
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (whsec_...
# temporaire, different de celui de prod). En production, obtenu en
# enregistrant l'endpoint dans le Dashboard Stripe (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=

# URL de base du site, utilisee pour les redirections apres paiement
# (success_url / cancel_url de Stripe Checkout). Ne pas deduire de l'en-tete
# Origin de la requete (controlable par l'appelant).
SITE_URL=http://localhost:3000
