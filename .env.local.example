ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# A renseigner uniquement si l'API renvoie l'erreur
# "anthropic-workspace-id is required when authenticating with an identity-linked API key"
# Trouvable dans la Console Anthropic > Settings > Workspaces (format wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# Projet Supabase (Project Settings > API) — utilisé uniquement cote serveur
# pour tracer les generations (table "generations"), jamais expose au client.
# Attention : SUPABASE_SERVICE_ROLE_KEY est la cle secrete a privileges eleves
# ("service_role" sur l'ancien systeme de cles JWT, "Secret key" / sb_secret_...
# sur le nouveau) — jamais la cle "anon public" / "Publishable key".
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Paiement a l'unite par generation ("pack par entretien"), etape 3.
# Cle secrete Stripe (Developers > API keys) — sk_test_... en dev, sk_live_...
# en production. Jamais exposee au client.
STRIPE_SECRET_KEY=

# Ids des 3 prix Stripe, une variable par offre (differents entre mode test et
# mode live : on change ces valeurs sur Vercel, jamais le code).
# - UNIQUE : "Fiche unique", 3,99 EUR, paiement unique (remplace l'ancienne
#   STRIPE_PRICE_ID, encore acceptee en repli pour cette seule offre).
# - HEBDO : "Pass hebdomadaire", 6,99 EUR, paiement unique (acces 7 jours).
# - MENSUEL : "Illimite", 9,99 EUR, prix RECURRENT mensuel (abonnement).
STRIPE_PRICE_ID_UNIQUE=price_xxx
STRIPE_PRICE_ID_HEBDO=price_xxx
STRIPE_PRICE_ID_MENSUEL=price_xxx

# Secret de signature du webhook Stripe, pour verifier que les appels a
# /api/webhooks/stripe viennent bien de Stripe. En local, fourni par
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (whsec_...
# temporaire, different de celui de prod). En production, obtenu en
# enregistrant l'endpoint dans le Dashboard Stripe (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=

# URL de base du site, utilisee pour les redirections apres paiement
# (success_url / cancel_url de Stripe Checkout). Ne pas deduire de l'en-tete
# Origin de la requete (controlable par l'appelant). En production :
# https://www.candiview.fr (avec www, pour eviter une redirection apres paiement).
SITE_URL=http://localhost:3000

# Secret du cron quotidien /api/keep-alive (evite la pause automatique de
# Supabase). A definir uniquement sur Vercel (Production) : Vercel l'envoie
# alors tout seul en "Authorization: Bearer ...". Valeur aleatoire d'au moins
# 32 caracteres (ex. `openssl rand -hex 32`). Optionnel en local, sauf pour
# tester la route a la main.
CRON_SECRET=

# Recuperation d'acces par email (lien magique), envoyee via Resend depuis le
# sous-domaine verifie send.candiview.fr (voir TODO.md pour la mise en place
# chez Resend et IONOS). Cle API limitee a l'envoi sur ce domaine.
RESEND_API_KEY=
# Optionnel : expediteur (defaut ci-dessous). Les reponses vont a contact@candiview.fr.
EMAIL_FROM=CandiView <acces@send.candiview.fr>
# Optionnels : limites de la recuperation par email. Defauts : 10 demandes par
# heure et par IP, 50 emails reellement envoyes par jour au total (volontairement
# bas : le quota Resend est partage avec les confirmations de commande).
RECOVERY_IP_HOURLY_LIMIT=10
RECOVERY_GLOBAL_DAILY_LIMIT=50
# Optionnel : cle des empreintes d'adresses/IP (par defaut derivee de la cle
# serveur Supabase). Changer cette valeur remet les compteurs a zero.
RECOVERY_HASH_SECRET=
# Developpement uniquement (ignore en production) : adresse d'un faux serveur
# Resend local, pour tester l'envoi sans vrai email.
RESEND_API_URL=

# Plafond anti-abus ("usage raisonnable", non affiche) : nombre maximal de
# generations par 24 h glissantes pour un Pass hebdo / abonnement. Optionnel,
# 10 par defaut.
ACCESS_DAILY_GENERATION_LIMIT=10
